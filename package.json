{
  "name": "anime-tag-prompt-builder",
  "private": true,
  "version": "0.1.0",
  "atelierEdition": "owner",
  "githubReleaseRepo": "Falafel0/prompt-atelier",
  "description": "Windows-first anime prompt and tag builder.",
  "author": "Prompt Atelier",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"npm:electron\"",
    "electron": "wait-on tcp:5173 && electron .",
    "build": "tsc -b && vite build",
    "build:public": "set \"PROMPT_ATELIER_EDITION=public\"&& npm run build",
    "build:owner": "set \"PROMPT_ATELIER_EDITION=owner\"&& npm run build",
    "package:win": "npm run build && electron-builder --win --x64 --publish never",
    "package:win:public": "set \"PROMPT_ATELIER_EDITION=public\"&& npm run build && electron-builder --win --x64 --publish never --config.appId=com.promptatelier.public --config.directories.output=release/public --config.extraMetadata.atelierEdition=public --config.extraMetadata.githubReleaseRepo=Falafel0/prompt-atelier",
    "package:win:owner": "set \"PROMPT_ATELIER_EDITION=owner\"&& npm run build && electron-builder --win --x64 --publish never --config.appId=com.promptatelier.owner --config.productName=PromptAtelierOwner --config.directories.output=release/owner --config.extraMetadata.atelierEdition=owner",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "better-sqlite3": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "zustand": "latest"
  },
  "devDependencies": {
    "@types/better-sqlite3": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest",
    "wait-on": "latest"
  },
  "build": {
    "appId": "com.promptatelier.desktop",
    "productName": "Prompt Atelier",
    "asar": true,
    "asarUnpack": ["node_modules/better-sqlite3/**"],
    "files": ["dist/**", "electron/**/*.cjs", "assets/**", "package.json"],
    "win": {
      "icon": "assets/prompt-atelier-icon.png",
      "target": [{ "target": "nsis", "arch": ["x64"] }]
    },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  },
  "allowScripts": { "better-sqlite3@13.0.3": true }
}
